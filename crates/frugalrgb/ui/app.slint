import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, Slider } from "std-widgets.slint";

// One zone of a device, as a row in the zone list.
export struct ZoneCard {
    device: string,
    zone: string,
    // First zone of its device: the device name is shown above it.
    header: bool,
    enabled: bool,
    color: color,
}

// A checkbox with no state of its own: it shows what the model says, so a
// preset loaded from code can never disagree with what is on screen.
component Check inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: root.checked ? Palette.accent-background : #7a8090;
    background: touch.has-hover ? #ffffff18 : transparent;

    Rectangle {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        background: root.checked ? Palette.accent-background : transparent;
    }

    touch := TouchArea {
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

component ZoneRow inherits Rectangle {
    in property <ZoneCard> card;
    callback toggled(bool);
    callback painted();

    height: 30px;
    border-radius: 6px;
    background: #ffffff0a;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Check {
                checked: root.card.enabled;
                toggled(on) => {
                    root.toggled(on);
                }
            }
        }

        Text {
            text: root.card.zone;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: root.card.enabled ? Palette.foreground : Palette.foreground.transparentize(0.55);
        }

        VerticalLayout {
            alignment: center;
            // The zone's colour. Clicking it paints the zone with the brush.
            Rectangle {
                width: 46px;
                height: 18px;
                border-radius: 4px;
                border-width: 1px;
                border-color: swatch-touch.has-hover ? #ffffff : #ffffff40;
                background: root.card.color;
                opacity: root.card.enabled ? 1 : 0.3;

                swatch-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.painted();
                    }
                }
            }
        }
    }
}

component Heading inherits Text {
    font-size: 11px;
    font-weight: 700;
    color: Palette.foreground.transparentize(0.45);
}

component ColorButton inherits Rectangle {
    in property <color> shade;
    in property <string> label;
    callback picked(color);

    height: 26px;
    horizontal-stretch: 1;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.has-hover ? #ffffff : #ffffff30;
    background: root.shade;

    Text {
        text: root.label;
        font-size: 11px;
        // Dark text on the bright shades
        color: root.shade.to-hsv().value > 0.8 && (root.shade.to-hsv().saturation < 0.5 || root.shade.green > 180) ? #101010 : #ffffff;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked(root.shade);
        }
    }
}

component LabelledSlider inherits HorizontalLayout {
    in property <string> label;
    in property <string> readout;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    callback changed();
    callback released();

    spacing: 8px;

    Text {
        text: root.label;
        width: 14px;
        vertical-alignment: center;
    }

    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        changed => {
            root.changed();
        }
        released => {
            root.released();
        }
    }

    Text {
        text: root.readout;
        width: 40px;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: Palette.foreground.transparentize(0.3);
    }
}

// A box over the dimmed window. Nothing underneath can be clicked.
component Modal inherits Rectangle {
    in property <string> title;

    background: #000000c0;

    TouchArea { }

    Rectangle {
        width: 500px;
        height: box.preferred-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: #ffffff30;
        background: Palette.background;

        box := VerticalLayout {
            padding: 20px;
            spacing: 14px;

            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
            }

            @children
        }
    }
}

